@page
@model RoomLoom.Api.Pages.IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RoomLoom — Sessions</title>
</head>
<body>
    <h1>RoomLoom</h1>

    <h2>Create a session</h2>
    <form method="post">
        <input asp-for="Title" type="text" placeholder="Session title" />
        <input asp-for="StartTime" type="datetime-local" />
        <button type="submit">Create</button>
        @if (Model.Error is not null)
        {
            <span>@Model.Error</span>
        }
    </form>

    <h2>Upcoming sessions</h2>
    @if (Model.Sessions.Count == 0)
    {
        <p>No upcoming sessions.</p>
    }
    else
    {
        <ul>
            @foreach (var s in Model.Sessions)
            {
                <li>
                    <a href="/room/@s.Id">@s.Title</a>
                    — @s.StartTime.ToLocalTime().ToString("g")
                    (@s.PlannedStatus)
                </li>
            }
        </ul>
    }
</body>
</html>
