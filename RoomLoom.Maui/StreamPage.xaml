<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomLoom.Maui.ViewModels"
             x:Class="RoomLoom.Maui.StreamPage"
             x:DataType="vm:StreamViewModel"
             Title="Stream">

    <Grid RowDefinitions="Auto,*">

        <HorizontalStackLayout Grid.Row="0" Padding="12,8" Spacing="10">
            <Label Text="Stream:" VerticalOptions="Center" />
            <Label Text="{Binding StatusText}" Style="{StaticResource StatusBadge}" />
        </HorizontalStackLayout>

        <HybridWebView Grid.Row="1"
                       x:Name="WebView"
                       HybridRoot="HybridRoot"
                       DefaultFile="index.html"
                       RawMessageReceived="OnRawMessageReceived" />

    </Grid>

</ContentPage>
